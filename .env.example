# Copy to .env. The API and worker refuse to start if a required value is missing.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://roost:roost@localhost:5433/roost
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=roost
CLICKHOUSE_PASSWORD=roost
CLICKHOUSE_DB=roost
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=roost
S3_ACCESS_KEY=roost
S3_SECRET_KEY=roostroost
# OpenRouter key for the AI proxy (module 2). Never shipped to clients.
OPENROUTER_API_KEY=
# Keys the HMAC of sign-in codes. Generate: openssl rand -hex 32
AUTH_SECRET=change-me-to-64-hex-chars-from-openssl-rand
# Who may create a NEW dashboard account: a@b.com, @b.com (whole domain), or * (anyone).
# Existing users can always sign in. Empty = nobody new.
SIGNUP_ALLOWLIST=*
# Sign-in emails: "smtp" or "resend". Dev uses Mailpit (inbox at http://localhost:8025).
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
EMAIL_FROM="Roost <no-reply@roost.local>"
