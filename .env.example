# Copy to .env. The API and worker refuse to start if a required value is missing.
# Values below suit local dev (`pnpm db:up && pnpm dev`). For a server, see DEPLOY.md:
# lines marked [deploy] need a real value there.

# ── Runtime ────────────────────────────────────────────────────────────────────
# "production" turns on secure cookies. docker-compose.yml sets it for you.
NODE_ENV=development
# API port. In Docker it is always 8787 (Caddy proxies to it).
PORT=8787

# ── Server (Docker) ────────────────────────────────────────────────────────────
# [deploy] Your domain, pointed at this server. Caddy gets the HTTPS certificate for it.
ROOST_DOMAIN=roost.example.com
# [deploy] Password for the bundled Postgres. Use `openssl rand -hex 24` (it goes in a URL).
POSTGRES_PASSWORD=roost
# POSTGRES_USER=roost

# ── Postgres ───────────────────────────────────────────────────────────────────
# Dev only: in Docker, compose builds this from POSTGRES_PASSWORD and points it at the container.
DATABASE_URL=postgres://roost:roost@localhost:5433/roost

# ── ClickHouse (events, AI calls, crashes) ─────────────────────────────────────
# In Docker, compose overrides CLICKHOUSE_URL and CLICKHOUSE_DB; the user and password
# below also create the ClickHouse account. [deploy] password: `openssl rand -hex 24`.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=roost
CLICKHOUSE_PASSWORD=roost
CLICKHOUSE_DB=roost

# ── S3-compatible storage (attachments, crash dumps, debug files, backups) ─────
# [deploy] Bundled RustFS: S3_ENDPOINT=http://s3:9000, and pick a long S3_ACCESS_KEY /
# S3_SECRET_KEY (they create its account). Any other S3 (AWS, R2, B2…): its endpoint and keys.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=roost
S3_ACCESS_KEY=roost
S3_SECRET_KEY=roostroost
S3_REGION=us-east-1

# ── Backups (the `backup` service in docker-compose.yml) ───────────────────────
# Daily pg_dump + ClickHouse BACKUP into s3://$S3_BUCKET/$BACKUP_PREFIX/ at BACKUP_HOUR UTC.
# Nothing is deleted automatically: set an S3 lifecycle rule on the prefix (DEPLOY.md).
BACKUP_PREFIX=backups
BACKUP_HOUR=3

# ── Auth ───────────────────────────────────────────────────────────────────────
# [deploy] Keys the HMAC of sign-in codes and encrypts webhook URLs. API and worker share it.
# Generate: openssl rand -hex 32
AUTH_SECRET=change-me-to-64-hex-chars-from-openssl-rand
# [deploy] Who may create a NEW dashboard account: a@b.com, @b.com (whole domain), or * (anyone).
# Existing users can always sign in. Empty = nobody new. On a public server never leave it at *.
SIGNUP_ALLOWLIST=*

# ── Email (sign-in codes, invites, alerts) ─────────────────────────────────────
# [deploy] "smtp" or "resend". Dev uses Mailpit (inbox at http://localhost:8025).
EMAIL_PROVIDER=smtp
# smtp://user:pass@host:587 (smtps://… for port 465). Required when EMAIL_PROVIDER=smtp.
SMTP_URL=smtp://localhost:1025
# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# [deploy] A sender your provider lets you send from (a verified domain for Resend).
EMAIL_FROM="Roost <no-reply@roost.local>"

# ── Links and integrations ─────────────────────────────────────────────────────
# [deploy] Public dashboard address, used in emails, alerts and Linear issues: https://$ROOST_DOMAIN
# Dev: http://localhost:5173
DASHBOARD_URL=
# OpenRouter key for the AI proxy. Never shipped to clients. Without it /v1/ai/* answers 503.
OPENROUTER_API_KEY=

# ── Advanced (defaults are fine) ───────────────────────────────────────────────
# Apply Postgres and ClickHouse migrations when the API starts. Set false to run them yourself.
# MIGRATE_ON_START=true
# Where the API finds migrations and the built SDKs. The Docker image sets all three.
# PG_MIGRATIONS_DIR=../../packages/db/migrations
# CH_MIGRATIONS_DIR=../../packages/clickhouse/migrations
# SDK_DIR=../../dist/sdk
# Worker: path to Mozilla's minidump-stackwalk (the worker image ships it).
# MINIDUMP_STACKWALK=minidump-stackwalk
