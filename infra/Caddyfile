# One origin: dashboard at /, API at /v1, /admin, /health and /sdk (SDK downloads).
{$ROOST_DOMAIN} {
	encode zstd gzip

	@api path /v1/* /admin/* /health /sdk /sdk/*
	handle @api {
		# Looks up every `api` container (re-checked every 10s), so `--scale api=N` spreads requests.
		reverse_proxy {
			dynamic a api 8787 {
				refresh 10s
			}
			lb_policy round_robin
			lb_try_duration 5s
		}
	}

	handle {
		root * /srv/dashboard
		try_files {path} /index.html
		file_server
	}
}
